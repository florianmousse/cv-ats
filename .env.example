# Copie ce fichier vers .env.local pour les essais sur ton ordinateur.
# Sur Vercel : Settings > Environment Variables, puis redéployer.
# Ne jamais utiliser NEXT_PUBLIC_ pour la clé et ne jamais la committer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Authentification privée : ces trois variables restent UNIQUEMENT côté serveur.
# Projet Supabase dédié recommandé. Désactiver les inscriptions publiques.
SUPABASE_URL=https://ton-projet.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Initialisation / récupération de l’administrateur sur ton ordinateur uniquement.
# Ne pas ajouter ces deux variables à Vercel. Supprimer ADMIN_PASSWORD après usage.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Requis pour enregistrer/utiliser des clés Gemini personnelles (32 octets en base64).
# Générer UNE FOIS : node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Conserver cette valeur secrète, stable et identique pour les déploiements partageant la base.
API_KEY_ENCRYPTION_SECRET=
